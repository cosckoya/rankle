# Rankle Configuration Template
# Copy this file to .env and customize for your environment
# Environment variables override these values

# Database Configuration
# SQLite (default - zero config)
DATABASE_URL=sqlite:///rankle.db

# For in-memory database (testing only)
# DATABASE_URL=sqlite:///:memory:

# For PostgreSQL (requires postgres driver)
# DATABASE_URL=postgresql://user:password@localhost:5432/rankle

# Output Backend Configuration
# Options: console, json, sqlite
OUTPUT_BACKEND=console

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# HTTP Client Settings
# User-Agent for HTTP requests
# USER_AGENT=Mozilla/5.0 (...)

# Timeout Settings (seconds)
# DEFAULT_TIMEOUT=45
# DNS_TIMEOUT=10
# SSL_TIMEOUT=10
# CRT_SH_TIMEOUT=30

# Rate Limiting
# RATE_LIMIT_DELAY=0.5
# MAX_CONCURRENT_REQUESTS=5

# Detection Thresholds
# MINIMUM_DETECTION_CONFIDENCE=0.2
# CDN_DETECTION_THRESHOLD=0.3
# WAF_DETECTION_THRESHOLD=0.3
